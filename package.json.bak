{
  "name": "open-primitive-mcp",
  "version": "1.2.0",
  "mcpName": "io.github.writesdavid/open-primitive",
  "description": "MCP server for 33 tools across 30 federal data domains — courts, federal register, education, infrastructure, unclaimed property, entity graph, subscriptions, compliance, plus flights, cars, food, water, drugs, hospitals, health, nutrition, jobs, demographics, products, SEC, safety, weather, and more",
  "main": "mcp.js",
  "bin": {
    "open-primitive-mcp": "./mcp.js"
  },
  "files": ["mcp.js", "sources/", "package.json"],
  "keywords": ["mcp", "model-context-protocol", "federal-data", "government", "ai-agents", "open-primitive"],
  "author": "David Hamilton <davehamiltonj@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/writesdavid/open-primitive-api"
  },
  "dependencies": {
    "node-fetch": "^2.7.0",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "zod": "^3.24.0"
  }
}
